# MongoDB Atlas (MongoDB 9.0+, native reranking enabled in project settings)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=one-lesson
DB_NAME=one_lesson
PORT=8787

# ElevenLabs: robot voices (TTS) and teach-by-voice (Scribe STT)
ELEVENLABS_API_KEY=

# Optional: Auth0 verified teachers (SPA app; callbacks = your tunnel URL + http://localhost:8787)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
ROLLBACK_SUBS=

# Optional: EMBED_MODE=local runs embeddings on this machine instead of Atlas Automated Embedding
# EMBED_MODE=local

# Optional: ElevenLabs Conversational AI agent for Home 5 (npx tsx scripts/create-agent.ts)
ELEVENLABS_AGENT_ID=
