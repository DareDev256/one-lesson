{
  "name": "one-lesson",
  "version": "0.1.0",
  "private": true,
  "description": "Teach one robot. Every robot learns. Undo it in one click. A governed skill memory for a robot fleet on MongoDB Atlas.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "voice:warm": "tsx scripts/voice-warm.ts",
    "publish:direct": "tsx scripts/publish-direct.ts",
    "demo": "tsx scripts/demo-reset.ts && tsx scripts/voice-warm.ts && tsx server/index.ts",
    "control": "node scripts/control.mjs"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.30.0",
    "@elevenlabs/client": "^1.36.1",
    "@huggingface/transformers": "^4.3.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "mongodb": "^7.9.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.60",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
